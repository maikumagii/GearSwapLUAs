# Copy to .env and fill in. .env is git-ignored.

# Host port cloudflared (running on the Pi) forwards to. 8080-8082 are taken by EventMoogle.
SORTIELOG_HTTP_PORT=8090
# 127.0.0.1 = tunnel only. Use 0.0.0.0 to also open the dashboard at http://<pi-ip>:<port> on the LAN.
SORTIELOG_BIND=127.0.0.1

# One key per player: name:key pairs, comma separated. Generate keys with:  openssl rand -hex 24
SORTIELOG_KEYS=kalali:replace-with-a-long-random-key

# Optional TP bonus per WS for fTP normalization
SORTIELOG_TP_BONUS=

# Level correction for DEF/EVA estimates: monster level minus yours (e.g. 26 for a level 145
# boss vs iLv119). 0 = off. Whether Sortie applies it is unsettled; compare both.
SORTIELOG_LEVEL_DIFF=0
